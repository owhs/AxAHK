{
  "name": "Expander",
  "description": "Expander",
  "order": 1003,
  "css": "AxExpander.css",
  "include": "lib\\components\\Expander\\AxExpander.ahk",
  "requires": [],
  "controls": [
    {
      "type": "Expander",
      "label": "Expander",
      "icon": "E76C",
      "category": "Containers",
      "prefix": "exp",
      "box": true,
      "arg": {
        "key": "title",
        "label": "Title",
        "kind": "text",
        "default": "More"
      },
      "props": [
        {
          "key": "desc",
          "label": "Description",
          "kind": "text",
          "emit": "kv"
        },
        {
          "key": "icon",
          "label": "Icon",
          "kind": "icon",
          "emit": "kv"
        },
        {
          "key": "open",
          "label": "Open by default",
          "kind": "flag",
          "emit": "flag"
        },
        { "key": "actions", "label": "Header buttons", "kind": "options", "shape": "act", "emit": "none" }
      ],
      "events": [
        { "name": "Action", "sig": "name, win", "wire": "OnAction", "filter": "name",
          "word": "has a header button pressed", "help": "A header button, or an entry of its menu, was pressed: name says which" },
        "Click",
        "DoubleClick",
        "ContextMenu",
        "MouseDown",
        "MouseUp",
        "Focus",
        "Blur"
      ]
    }
  ]
}
