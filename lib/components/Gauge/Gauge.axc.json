{
  "name": "Gauge",
  "description": "A dial that shows one number. The worked example for a component pack.",
  "order": 7400,
  "css": "AxGauge.css",
  "include": "lib\\components\\Gauge\\AxGauge.ahk",
  "requires": [],
  "controls": [
    {
      "type": "Gauge",
