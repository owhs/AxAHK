        {
          "key": "showhex",
          "label": "Show hex",
          "kind": "flag",
          "emit": "flag"
        },
        {
          "key": "small",
          "label": "Small swatches",
          "kind": "flag",
          "emit": "flag"
        }
      ],
      "events": [
        "Change",
        "Click",
        "DoubleClick",
        "ContextMenu",
        "Focus",
        "Blur"
      ]
    }
  ]
