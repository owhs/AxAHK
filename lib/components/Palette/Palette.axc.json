{
  "name": "Palette",
  "description": "Colour palette",
  "order": 3008,
  "css": "AxPalette.css",
  "include": "lib\\components\\Palette\\AxPalette.ahk",
  "requires": [],
  "controls": [
    {
      "type": "Palette",
      "label": "Colour palette",
      "icon": "E790",
