{
  "name": "Stepper",
  "description": "The steps of a wizard: done, now, still to come.",
  "order": 2021,
  "css": "AxStepper.css",
  "include": "lib\\components\\Stepper\\AxStepper.ahk",
  "requires": [],
  "controls": [
    {
      "type": "Stepper",
