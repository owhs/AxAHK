   "flows": "resetBtn Click -> assign fullName \"\"\nresetBtn Click -> assign email \"\"\nresetBtn Click -> assign phone \"\"\nresetBtn Click -> assign skills \"\"\nresetBtn Click -> assign notes \"\"\nresetBtn Click -> toast Cleared",
   "states": "",
   "binds": "nameBox <-> fullName\nemailBox <-> email\nphoneBox <-> phone\nteamDdl <-> team\nskillTags <-> skills\nyearsNum <-> years\nnotesBox <-> notes\nemailLbl.Text <- emailHint\ndoneBar.Value <- done\ndoneLbl.Text <- doneText\nsaveBtn.Enabled <- canSave\nsummaryBar <- summary",
   "hotkeys": "",
   "init": "",
   "script": "; One line per contact, in a CSV beside the script.\nSaveContact() {\n    global g, fullName, email, phone, team, skills, years, notes\n    f := A_ScriptDir \"\\contacts.csv\"\n    q := (s) => '\"' StrReplace(String(s), '\"', '\"\"') '\"'\n    if !FileExist(f)\n        FileAppend(\"Name,Email,Phone,Team,Skills,Years,Notes`n\", f, \"UTF-8\")\n    FileAppend(q(fullName) \",\" q(email) \",\" q(phone) \",\" q(team) \",\" q(skills) \",\" years \",\" q(notes) \"`n\", f, \"UTF-8\")\n    g.Toast(\"Saved \" Trim(fullName), 2000, \"success\")\n}",
