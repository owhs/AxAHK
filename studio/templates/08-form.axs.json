 "cur": 1,
 "vars": "fullName = \"\"\nemail = \"\"\nphone = \"\"\nteam = \"eng\"\nskills = \"\"\nyears = 3\nnotes = \"\"\nemailOk <- RegExMatch(email, \"i)^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$\") ? 1 : 0\nnameOk <- StrLen(Trim(fullName)) >= 2 ? 1 : 0\ndone <- Round(100 * (nameOk + emailOk + (Trim(phone) != \"\") + (skills != \"\") + (Trim(notes) != \"\")) / 5)\ndoneText <- done \"% filled in\"\ncanSave <- nameOk && emailOk\nemailHint <- email = \"\" ? \"The welcome note goes here.\" : emailOk ? \"That looks right.\" : \"That does not look like an email yet.\"\nsummary <- (nameOk ? Trim(fullName) : \"Someone\") (emailOk ? \" <\" email \">\" : \"\") \", \" (team = \"eng\" ? \"Engineering\" : team = \"des\" ? \"Design\" : \"Operations\") \", \" years \" year\" (years = 1 ? \"\" : \"s\") \" of experience\"",
