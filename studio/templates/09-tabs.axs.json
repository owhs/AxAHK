   "flows": "goBtn Click -> call Process\npasteBtn Click -> call PasteIn\ncopyBtn Click -> call CopyOut",
   "states": "",
   "binds": "caseSeg <-> caseMode\ntrimSw <-> trimLines\ndedupeSw <-> dedupe\nsortSw <-> sortLines",
   "hotkeys": "F5 | active | own | Process\n^+v | active | own | PasteIn\n^+c | active | own | CopyOut",
   "init": "",
   "script": "; The input, line by line, through the options -- into the output.\nProcess() {\n    global g, input, output, tabs, caseMode, trimLines, dedupe, sortLines\n    seen := Map(), out := \"\", n := 0\n    for line in StrSplit(StrReplace(input.Text, \"`r\", \"\"), \"`n\") {\n        if trimLines\n            line := Trim(line)\n        switch caseMode {\n        case \"upper\": line := StrUpper(line)\n        case \"lower\": line := StrLower(line)\n        case \"title\": line := StrTitle(line)\n        }\n        if dedupe {\n            if seen.Has(line)\n                continue\n            seen[line] := true\n        }\n        out .= (n++ ? \"`n\" : \"\") line\n    }\n    if sortLines\n        out := Sort(out)\n    output.Text := out\n    tabs.Value := 2\n    g.Status(\"msg\", n \" lines processed\")\n    g.Status(\"len\", StrLen(out) \" characters\")\n}\nPasteIn() {\n    global input, tabs\n    input.Text := A_Clipboard\n    tabs.Value := 1\n}\nCopyOut() {\n    global g, output\n    A_Clipboard := output.Text\n    g.Toast(\"Copied\", 1200, \"success\")\n}",
