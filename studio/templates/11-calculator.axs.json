   "binds": "display.Text <- shown\nlastLbl.Text <- last\nmemLbl.Text <- memText",
   "hotkeys": "^c | active | own | CopyResult\n^v | active | own | PasteNumber",
   "init": "g.On(\"keydown\", \"*\", KeyIn)",
   "script": "expr := \"\"\n\n; One key, from a button or the keyboard.\nPress(key) {\n    global expr, shown, last, mem\n    switch key {\n    case \"C\":\n        expr := \"\", shown := \"0\"\n    case \"back\":\n        expr := SubStr(expr, 1, -1)\n        shown := (expr = \"\") ? \"0\" : expr\n    case \"=\":\n        if (expr = \"\")\n            return\n        r := Calc(expr)\n        last := expr \" =\"\n        shown := r, expr := (r = \"Error\") ? \"\" : r\n    case \"neg\":\n        expr := (SubStr(expr, 1, 1) = \"-\") ? SubStr(expr, 2) : \"-\" expr\n        shown := (expr = \"\") ? \"0\" : expr\n    case \"%\":\n        r := Calc(expr)\n        expr := (r = \"Error\") ? \"\" : Nice(r / 100), shown := (expr = \"\") ? \"Error\" : expr\n    case \"MC\":\n        mem := 0\n    case \"MR\":\n        expr .= mem, shown := expr\n    case \"M+\":\n        r := Calc(expr)\n        if (r != \"Error\")\n            mem := Calc(mem \"+\" r)\n    default:\n        expr .= key, shown := expr\n    }\n    AxBindSync()\n}\n\n; The sum, * and / before + and -. A minus at the start, or straight\n; after another sign, belongs to the number.\nCalc(s) {\n    toks := [], num := \"\"\n    loop parse s {\n        c := A_LoopField\n        if InStr(\"0123456789.\", c) || (c = \"-\" && num = \"\" && (!toks.Length || !IsNumber(toks[toks.Length])))\n            num .= c\n        else if InStr(\"+-*/\", c) {\n            if (num = \"\" || num = \"-\" || !IsNumber(num))\n                return \"Error\"\n            toks.Push(num + 0), toks.Push(c), num := \"\"\n        }\n    }\n    if (num = \"\" || num = \"-\" || !IsNumber(num))\n        return \"Error\"\n    toks.Push(num + 0)\n    i := 2\n    while (i <= toks.Length) {\n        if (toks[i] = \"*\" || toks[i] = \"/\") {\n            if (toks[i] = \"/\" && toks[i + 1] = 0)\n                return \"Error\"\n            toks[i - 1] := (toks[i] = \"*\") ? toks[i - 1] * toks[i + 1] : toks[i - 1] / toks[i + 1]\n            toks.RemoveAt(i, 2)\n        } else\n            i += 2\n    }\n    r := toks[1], i := 2\n    while (i <= toks.Length) {\n        r := (toks[i] = \"+\") ? r + toks[i + 1] : r - toks[i + 1]\n        i += 2\n    }\n    return Nice(r)\n}\nNice(n) {\n    if (Floor(n) = n && Abs(n) < 1e15)\n        return String(Integer(n))\n    return RTrim(RTrim(Format(\"{:.10f}\", n), \"0\"), \".\")\n}\n\n; The keyboard, anywhere in the window.\nKeyIn(el, ev) {\n    k := ev.keyCode, sh := ev.shiftKey\n    key := (k >= 96 && k <= 105) ? String(k - 96)\n         : (k = 56 && sh) || k = 106 ? \"*\"\n         : (k = 187 && sh) || k = 107 ? \"+\"\n         : (k = 53 && sh) ? \"%\"\n         : (k >= 48 && k <= 57 && !sh) ? String(k - 48)\n         : (k = 189 || k = 109) ? \"-\"\n         : (k = 191 || k = 111) ? \"/\"\n         : (k = 190 || k = 110) ? \".\"\n         : (k = 13 || k = 187) ? \"=\"\n         : (k = 8) ? \"back\"\n         : (k = 27 || k = 46) ? \"C\" : \"\"\n    if (key = \"\")\n        return\n    try ev.returnValue := false\n    Press(key)\n}\nCopyResult() {\n    global g, shown\n    A_Clipboard := shown\n    g.Toast(\"Copied \" shown, 1200)\n}\nPasteNumber() {\n    global expr, shown\n    expr .= RegExReplace(A_Clipboard, \"[^0-9.+\\-*/]\"), shown := expr\n    AxBindSync()\n}",
