   "menubar": "",
   "statusbar": "",
   "look": "",
   "css": "",
   "flows": "addBtn Click -> addrow tasks {newTask} | {due} | {prio}\naddBtn Click -> assign newText \"\"\naddBtn Click -> saverows tasks tasks.txt\naddBtn Click -> call Recount\ndelBtn Click -> removerow tasks\ndelBtn Click -> saverows tasks tasks.txt\ndelBtn Click -> call Recount\nallBtn Click -> tickall tasks\nallBtn Click -> saverows tasks tasks.txt\nallBtn Click -> call Recount\ntasks ItemCheck -> saverows tasks tasks.txt\ntasks ItemCheck -> call Recount",
   "states": "",
   "binds": "newTask <-> newText\naddBtn.Enabled <- hasText\nprogBar.Value <- pct\nsumLbl.Text <- summary",
   "hotkeys": "",
   "init": "if FileExist(A_ScriptDir \"\\tasks.txt\")\n    tasks.LoadFrom(A_ScriptDir \"\\tasks.txt\")\ntasks.ModifyCol(1, 320)\nRecount()",
   "script": "; How many there are and how many are ticked: the bar and the words\n; under the list are bound to these two.\nRecount() {\n    global g, tasks, total, doneCount\n    total := tasks.GetCount(), doneCount := 0, r := 0\n    while (r := tasks.GetNext(r, \"C\"))\n        doneCount++\n    AxBindSync()\n    g.Status(\"count\", total \" task\" (total = 1 ? \"\" : \"s\"))\n}\nClearDone() {\n    global tasks\n    r := tasks.GetCount()\n    while (r > 0) {\n        if (tasks.GetNext(r - 1, \"C\") = r)\n            tasks.Delete(r)\n        r--\n    }\n    tasks.SaveTo(A_ScriptDir \"\\tasks.txt\")\n    Recount()\n}",
