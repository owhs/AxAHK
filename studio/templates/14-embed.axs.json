   "init": "Go(\"https://www.autohotkey.com\")",
   "script": "; A web address, a bare name (example.com) or words to look up.\nGo(url := \"\") {\n    global web, addr\n    url := Trim(url != \"\" ? url : addr.Text)\n    if (url = \"\")\n        return\n    if !RegExMatch(url, \"i)^[a-z]+:\")\n        url := (InStr(url, \" \") || !InStr(url, \".\")) ? \"https://www.bing.com/search?q=\" url : \"https://\" url\n    addr.Text := url\n    web.Object.Navigate(url)\n}\n; Where the page is now and what it is called.\nWatch() {\n    global web, addr, g\n    static lastUrl := \"\"\n    try {\n        o := web.Object\n        u := o.LocationURL\n        if (u != \"\" && u != lastUrl)\n            lastUrl := u, addr.Text := u\n        g.Status(\"msg\", o.Busy ? \"Loading...\" : o.LocationName)\n        g.Status(\"secure\", SubStr(u, 1, 6) = \"https:\" ? \"Secure\" : \"\")\n    }\n}",
