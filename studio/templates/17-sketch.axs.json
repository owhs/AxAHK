      "hotkeys": "^z | active | own | Undo",
      "init": "",
      "script": "; The canvas does the drawing; these are the few things it is asked to do.\nUndo() {\n    global pad\n    pad.Component.Undo()\n}\nSavePicture() {\n    global g, pad\n    path := FileSelect(\"S16\", A_MyDocuments \"\\sketch.png\", \"Save the sketch\", \"PNG picture (*.png)\")\n    if (path = \"\")\n        return\n    if !RegExMatch(path, \"i)\\.png$\")\n        path .= \".png\"\n    if pad.Component.Save(path)\n        g.Status(\"msg\", \"Saved \" path)\n}",
      "root": {
        "id": "root",
        "type": "Root",
        "name": "",
        "arg": "",
        "layout": {},
        "props": {},
        "events": [],
        "kids": [
          {
            "arg": "#ffffff\n#ff5f6d\n#ffb900\n#7ed957\n#00b7c3\n#3a96dd\n#8764b8\n#e3008c",
            "id": "n1",
            "type": "Palette",
            "name": "colour",
            "events": [
              {
                "code": "pad.Component.Paint(true, value, size.Value)",
